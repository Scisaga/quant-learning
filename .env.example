# Storage 配置（MinIO + PostgreSQL）
# 复制为 .env 并修改为实际值
# 远程部署示例：已部署在 10.0.0.16 时使用以下配置

# MinIO（对象存储）
MINIO_ENDPOINT=http://10.0.0.16:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=quant-experiments
# MINIO_USE_SSL=false
# MINIO_REGION=us-east-1

# PostgreSQL（元数据）
DATABASE_URL=postgresql://quant:quant@10.0.0.16:5432/quant_experiments
# 或分项配置：
# POSTGRES_HOST=10.0.0.16
# POSTGRES_PORT=5432
# POSTGRES_USER=quant
# POSTGRES_PASSWORD=quant
# POSTGRES_DB=quant_experiments

# 是否启用持久化（设为 true 后 train/backtest/run_grid 会写入）
PERSIST_EXPERIMENTS=false
